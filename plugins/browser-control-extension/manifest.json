{
  "manifest_version": 3,
  "name": "Mana Browser Connection",
  "version": "1.0.0",
  "minimum_chrome_version": "125",
  "description": "Connect selected Chrome tabs to Mana with explicit session consent.",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mana Browser Connection", "default_popup": "popup.html" }
}
