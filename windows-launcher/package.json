{
  "name": "local-voice-bot-launcher",
  "version": "0.2.2",
  "description": "Electron launcher for the local AI assistant with wake-word listening",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dev": "nodemon --config nodemon.json",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "fetch-live2d-core": "node scripts/fetch-live2d-core.js",
    "fetch-sample-avatar": "node scripts/fetch-sample-avatar.js",
    "fetch-silero-vad": "node scripts/fetch-silero-vad.js",
    "check-live2d-model": "node scripts/check-live2d-model.js"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "onnxruntime-web": "^1.27.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.185.1"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  },
  "build": {
    "appId": "com.mana.ai.launcher",
    "productName": "Mana",
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
