<?xml version="1.0" encoding="utf-8"?>
<!-- #937: Folio comes from folio-feed\, a local package folder that pack-folio.ps1 fills from the commit pinned in
     ManaNativeLauncher.csproj. Everything else comes from nuget.org. The mapping keeps Folio's package ids from
     ever resolving from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="folio" value="folio-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="folio">
      <package pattern="Folio" />
      <package pattern="Folio.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
