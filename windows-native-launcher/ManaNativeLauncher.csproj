<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- #524: versioned (not plain net10.0-windows) so NuGet resolves
         Microsoft.Toolkit.Uwp.Notifications' windows10.0-specific asset,
         which is the only one carrying ToastNotificationManagerCompat,
         since the plain net5.0 asset (what an unversioned target resolves
         to) doesn't have it: toast activation needs WinRT interop that
         requires a versioned Windows SDK target. 10.0.19041.0 is a
         common, safely-below-current-Windows floor for that. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- .NET 9+ turns WFO1000 (a public property on a control/form with no
         designer serialization attribute) into an error. Every form here is
         built in code, never opened in the WinForms designer, so there is
         nothing to serialize. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- #479 sub-project 4: CubismModel.cs manages Cubism Core's aligned
         native buffers directly (NativeMemory.AlignedAlloc/AlignedFree,
         raw pointer arithmetic over the C API's array-of-pointers return
         values), unavoidable for a P/Invoke layer over a C API shaped
         like this one. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- #615: the real crystal-mark icon (converted from windows-launcher's
         own build/icon.png), replacing the SystemIcons.Application fallback
         both this exe and the tray icon used before. -->
    <ApplicationIcon>assets\mana.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- #680: UI Automation (System.Windows.Automation) for the text
         actions' password-field check and selection read. It ships in the
         WPF part of the desktop runtime; referenced directly rather than
         via UseWPF, which would also drop the System.IO implicit using. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <Target Name="FetchSileroVadModel" BeforeTargets="Build">
    <PropertyGroup>
      <SileroVadModelDir>$(MSBuildProjectDirectory)\assets\vad</SileroVadModelDir>
      <SileroVadModelPath>$(SileroVadModelDir)\silero_vad.onnx</SileroVadModelPath>
      <SileroVadModelUrl>https://raw.githubusercontent.com/snakers4/silero-vad/master/src/silero_vad/data/silero_vad.onnx</SileroVadModelUrl>
    </PropertyGroup>
    <MakeDir Directories="$(SileroVadModelDir)" Condition="!Exists('$(SileroVadModelDir)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(SileroVadModelUrl)' -OutFile '$(SileroVadModelPath)' -UserAgent 'mana-fetch-silero-vad'&quot;" Condition="!Exists('$(SileroVadModelPath)')" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- #342: the two openWakeWord backbone models (melspectrogram + speech
       embedding) are third-party pretrained models with a stable public
       release URL, so they follow the same fetch-at-build-time convention
       as silero_vad.onnx above rather than being committed. mana.onnx
       itself (our own trained classifier, in the same assets\wakeword\
       directory) IS committed directly, since nothing else hosts it yet. -->
  <Target Name="FetchWakeWordBackboneModels" BeforeTargets="Build">
    <PropertyGroup>
      <WakeWordModelDir>$(MSBuildProjectDirectory)\assets\wakeword</WakeWordModelDir>
      <MelspectrogramModelPath>$(WakeWordModelDir)\melspectrogram.onnx</MelspectrogramModelPath>
      <MelspectrogramModelUrl>https://github.com/dscripka/openWakeWord/releases/download/v0.5.1/melspectrogram.onnx</MelspectrogramModelUrl>
      <EmbeddingModelPath>$(WakeWordModelDir)\embedding_model.onnx</EmbeddingModelPath>
      <EmbeddingModelUrl>https://github.com/dscripka/openWakeWord/releases/download/v0.5.1/embedding_model.onnx</EmbeddingModelUrl>
    </PropertyGroup>
    <MakeDir Directories="$(WakeWordModelDir)" Condition="!Exists('$(WakeWordModelDir)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(MelspectrogramModelUrl)' -OutFile '$(MelspectrogramModelPath)' -UserAgent 'mana-fetch-wakeword-backbone'&quot;" Condition="!Exists('$(MelspectrogramModelPath)')" ContinueOnError="WarnAndContinue" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(EmbeddingModelUrl)' -OutFile '$(EmbeddingModelPath)' -UserAgent 'mana-fetch-wakeword-backbone'&quot;" Condition="!Exists('$(EmbeddingModelPath)')" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- #678: WeSpeaker's VoxCeleb ResNet34-LM speaker embedding (CC BY 4.0,
       see THIRD_PARTY.md) for the voiceprint gate, pinned to a revision and
       checked against its SHA-256 before it's kept. Same fetch-at-build-time
       convention as the models above; MANA_SPEAKER_MODEL points elsewhere. -->
  <Target Name="FetchSpeakerModel" BeforeTargets="Build">
    <PropertyGroup>
      <SpeakerModelDir>$(MSBuildProjectDirectory)\assets\speaker</SpeakerModelDir>
      <SpeakerModelPath>$(SpeakerModelDir)\voxceleb_resnet34_LM.onnx</SpeakerModelPath>
      <SpeakerModelUrl>https://huggingface.co/Wespeaker/wespeaker-voxceleb-resnet34-LM/resolve/f0c48c298fd835726c27956a5d617bad7115627e/voxceleb_resnet34_LM.onnx</SpeakerModelUrl>
      <SpeakerModelSha256>7bb2f06e9df17cdf1ef14ee8a15ab08ed28e8d0ef5054ee135741560df2ec068</SpeakerModelSha256>
    </PropertyGroup>
    <MakeDir Directories="$(SpeakerModelDir)" Condition="!Exists('$(SpeakerModelDir)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(SpeakerModelUrl)' -OutFile '$(SpeakerModelPath).tmp' -UserAgent 'mana-fetch-speaker-model'&quot;" Condition="!Exists('$(SpeakerModelPath)')" ContinueOnError="WarnAndContinue" />
    <VerifyFileHash File="$(SpeakerModelPath).tmp" Hash="$(SpeakerModelSha256)" Algorithm="SHA256" Condition="Exists('$(SpeakerModelPath).tmp')" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(SpeakerModelPath).tmp" DestinationFiles="$(SpeakerModelPath)" Condition="Exists('$(SpeakerModelPath).tmp') And '$(MSBuildLastTaskResult)' == 'true'" />
    <Delete Files="$(SpeakerModelPath).tmp" />
  </Target>

  <!-- #937: Folio, from the local package folder in nuget.config.
       pack-folio.ps1 builds the packages from FolioCommit and checks that
       they come out as FolioVersion; CI runs it before restoring. To bump
       Folio: set FolioCommit to a Folio commit on main, set FolioVersion to
       0.1.0-m1.N, where N is the number of commits in that commit's
       history, then run pack-folio.ps1 (README, Quick Start). -->
  <PropertyGroup>
    <FolioCommit>541a7f28cf0b8ed95c2fed86884a0c93a9cb28db</FolioCommit>
    <FolioVersion>0.1.0-m1.127</FolioVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManaNativeLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <!-- 4.153.0: Folio.Skia's own SkiaSharp, which a lower version here
         would downgrade (NU1605). -->
    <PackageReference Include="SkiaSharp" Version="4.153.0" />
    <!-- #937: draws static HTML artifacts in the viewer (FolioView). -->
    <PackageReference Include="Folio.WinForms" Version="$(FolioVersion)" />
    <!-- #524: native Windows toast notifications with action buttons for
         an unpackaged (no MSIX/Start Menu shortcut) WinForms app, the
         standard non-WinUI3 way to do this; the newer Windows App SDK
         AppNotificationManager needs packaging identity this project
         doesn't have. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK's default recursive glob does not exclude nested project
         directories on its own; without this, this project would also try
         to compile ManaNativeLauncher.Tests's sources (and its obj/bin
         output). -->
    <Compile Remove="ManaNativeLauncher.Tests\**" />
    <EmbeddedResource Remove="ManaNativeLauncher.Tests\**" />
    <None Remove="ManaNativeLauncher.Tests\**" />
  </ItemGroup>
</Project>
