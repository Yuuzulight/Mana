<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- #524: versioned (not plain net8.0-windows) so NuGet resolves
         Microsoft.Toolkit.Uwp.Notifications' windows10.0-specific asset,
         which is the only one carrying ToastNotificationManagerCompat,
         since the plain net5.0 asset (what an unversioned target resolves
         to) doesn't have it: toast activation needs WinRT interop that
         requires a versioned Windows SDK target. 10.0.19041.0 is a
         common, safely-below-current-Windows floor for that. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- #479 sub-project 4: CubismModel.cs manages Cubism Core's aligned
         native buffers directly (NativeMemory.AlignedAlloc/AlignedFree,
         raw pointer arithmetic over the C API's array-of-pointers return
         values), unavoidable for a P/Invoke layer over a C API shaped
         like this one. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="FetchSileroVadModel" BeforeTargets="Build">
    <PropertyGroup>
      <SileroVadModelDir>$(MSBuildProjectDirectory)\assets\vad</SileroVadModelDir>
      <SileroVadModelPath>$(SileroVadModelDir)\silero_vad.onnx</SileroVadModelPath>
      <SileroVadModelUrl>https://raw.githubusercontent.com/snakers4/silero-vad/master/src/silero_vad/data/silero_vad.onnx</SileroVadModelUrl>
    </PropertyGroup>
    <MakeDir Directories="$(SileroVadModelDir)" Condition="!Exists('$(SileroVadModelDir)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(SileroVadModelUrl)' -OutFile '$(SileroVadModelPath)' -UserAgent 'mana-fetch-silero-vad'&quot;" Condition="!Exists('$(SileroVadModelPath)')" ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="ManaNativeLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <!-- #524: native Windows toast notifications with action buttons for
         an unpackaged (no MSIX/Start Menu shortcut) WinForms app, the
         standard non-WinUI3 way to do this; the newer Windows App SDK
         AppNotificationManager needs packaging identity this project
         doesn't have. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK's default recursive glob does not exclude nested project
         directories on its own; without this, this project would also try
         to compile ManaNativeLauncher.Tests's sources (and its obj/bin
         output). -->
    <Compile Remove="ManaNativeLauncher.Tests\**" />
    <EmbeddedResource Remove="ManaNativeLauncher.Tests\**" />
    <None Remove="ManaNativeLauncher.Tests\**" />

    <!-- Backend server dependency: runs as a separate process with minimal memory footprint -->
  </ItemGroup>
</Project>
