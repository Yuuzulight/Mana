{"fps": 60, "duration": 47.9256, "screens": [{"key": "reveal", "start": 0.0, "end": 3.9938}, {"key": "name", "start": 3.9938, "end": 9.9845}, {"key": "nice", "start": 9.9845, "end": 11.9814}, {"key": "talk", "start": 11.9814, "end": 15.9752}, {"key": "screen", "start": 15.9752, "end": 17.9721}, {"key": "code", "start": 17.9721, "end": 21.9659}, {"key": "game", "start": 21.9659, "end": 25.9597}, {"key": "everything", "start": 25.9597, "end": 29.9535}, {"key": "memory", "start": 29.9535, "end": 33.9473}, {"key": "tease", "start": 33.9473, "end": 37.9411}, {"key": "promise", "start": 37.9411, "end": 41.9349}, {"key": "signoff", "start": 41.9349, "end": 47.9256}], "lines": [{"key": "01-reveal", "start": 0.9, "end": 3.7328, "text": "Hi hi! Can you hear me? Oh, it worked!"}, {"key": "02-name", "start": 4.3438, "end": 8.6627, "text": "I'm Mana, a little mana-crystal spirit who lives in your PC!"}, {"key": "03-nice", "start": 10.2845, "end": 11.5384, "text": "Nice to meet you!"}, {"key": "04-talk", "start": 12.0814, "end": 14.2176, "text": "Talk to me, and I'll talk back!"}, {"key": "05-screen", "start": 16.0752, "end": 17.747, "text": "I can see your screen, too."}, {"key": "06-code", "start": 18.0721, "end": 21.0443, "text": "I'll fix your code, but only if you say yes."}, {"key": "07-game", "start": 22.0659, "end": 25.5025, "text": "Gaming? I'll be quiet. Streaming? I'm in!"}, {"key": "08-everything", "start": 26.0597, "end": 28.9854, "text": "Phone, Discord, and pretty much everything else."}, {"key": "09-memory", "start": 30.0535, "end": 32.1897, "text": "And I remember what we did together."}, {"key": "10-tease", "start": 34.2973, "end": 36.6193, "text": "Fair warning: I like to tease!"}, {"key": "11-promise", "start": 38.0411, "end": 40.038, "text": "Everything stays on your PC."}, {"key": "12-signoff", "start": 42.0349, "end": 43.3352, "text": "Can't wait to meet you!"}, {"key": "13-otsumana", "start": 43.5849, "end": 44.3744, "text": "Otsumana~!"}], "mouth": [0.0, 