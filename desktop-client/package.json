{
  "name": "mana-desktop-client",
  "version": "0.3.0",
  "description": "Mana desktop Electron client that spawns the local Mana backend, records audio, and plays TTS",
  "author": "ManaAI",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never",
    "fetch-live2d-core": "node scripts/fetch-live2d-core.js",
    "fetch-sample-avatar": "node scripts/fetch-sample-avatar.js",
    "fetch-silero-vad": "node scripts/fetch-silero-vad.js",
    "prepare-portable-python": "node scripts/prepare-portable-python.js"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "onnxruntime-web": "^1.27.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  },
  "build": {
    "appId": "com.mana.ai",
    "productName": "Mana",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}"
    ],
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "Yuuzulight",
      "repo": "Mana"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Mana-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "extraResources": [
      {
        "from": "../node-bot",
        "to": "node-bot",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../plugins",
        "to": "plugins",
        "filter": [
          "**/*",
          "!**/test/**"
        ]
      },
      {
        "from": "../node-bin",
        "to": "node_bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../tools/searxng",
        "to": "tools/searxng",
        "filter": [
          "**/*",
          "!venv/**",
          "!__pycache__/**"
        ]
      },
      {
        "from": "../tools/mana-searxng-settings.yml",
        "to": "tools/mana-searxng-settings.yml"
      },
      {
        "from": "../tts-service",
        "to": "tts-service",
        "filter": [
          "kokoro_service.py",
          "requirements-packaged.txt",
          "kokoro/**/*"
        ]
      },
      {
        "from": "portable-python",
        "to": "portable-python",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
